export function getPublishedServices(): MenuService[] {
  return menuServices.filter((s) => s.published);
}

export function getServicesByCategory(
  categoryId: MenuCategoryId,
): MenuService[] {
  return getPublishedServices().filter((s) => s.categoryId === categoryId);
}

export function hasExperiencePrice(service: MenuService): boolean {
  return service.experiencePrice != null;
}

/** Dedicated first-visit trial courses (the original $1,299 set). */
export function isDedicatedTrial(service: MenuService): boolean {
  return service.categoryId === "first-experience";
}

/**
 * Services shown in First Experience section only.
 * Must NOT include regular category treatments — those already show
 * experiencePrice in their category lists.
 */
export function getTrialHighlights(): MenuService[] {
  return getPublishedServices().filter(
    (s) => isDedicatedTrial(s) && hasExperiencePrice(s),
  );
}

/** @deprecated Prefer getTrialHighlights — kept for older imports. */
export function getExperienceServices(): MenuService[] {
  return getTrialHighlights();
}

/** Whether a category has a dedicated $1,299 trial course (not all experience prices). */
export function categoryHasDedicatedTrial(
  categoryId: MenuCategoryId,
): boolean {
  return getPublishedServices().some(
    (s) => isDedicatedTrial(s) && s.relatedCategoryId === categoryId,
  );
}

export function getCategoryName(categoryId: MenuCategoryId): string {
  return menuCategories.find((c) => c.id === categoryId)?.name ?? "";
}

export function formatDuration(minutes: number | null): string {
  if (minutes == null) return "";
  return `${minutes} MIN`;
}

export function formatPrice(price: number | null): string {
  if (price == null) return "請洽詢";
  return `$${price.toLocaleString("en-US")}`;
}
